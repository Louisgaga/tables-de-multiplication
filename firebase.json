{
  "firestore": [
    {
      "database": "ai-studio-2ab8ae63-1e6d-401b-8adb-24893f34ca27",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "site": "mes-tables-de-multiplication",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "npm run build"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8181
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
